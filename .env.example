# Public site URL (canonical links, sitemap, Open Graph, JSON-LD, /llms.txt)
NEXT_PUBLIC_SITE_URL=https://tourworldtourism.com

# Public GET /api/* is rate-limited in-process (120/min/IP). Use a single instance or add Redis for multi-node.

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/tourworld

# Auth (NextAuth)
NEXTAUTH_URL=https://tourworldtourism.com
NEXTAUTH_SECRET=generate-a-long-random-secret
AUTH_SECRET=generate-a-long-random-secret
